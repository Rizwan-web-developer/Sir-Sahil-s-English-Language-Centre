# Supabase project
# Create a project at https://supabase.com/dashboard and copy the values from
# Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this to the browser or commit a real value.
# Used by scripts/seed.ts and server-side admin operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Show demo credential hints on the login page (set to "true" only for local/demo).
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true

# Cloudflare R2 (S3-compatible) - used for assignment video uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
